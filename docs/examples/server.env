# A starting .env for one always-on Linux server that a small team shares (docs/unattended.md).
#
#   cp docs/examples/server.env .env && npm run setup
#
# setup fills in DASHBOARD_TOKEN, MCP_TOKEN and WORKTREES_ROOT when they are empty, makes .env
# private (0600) and never overwrites a value you set. Fill in the rest by hand. An empty value means
# the default. Every variable the server, the dashboard and scripts/heavy read is listed here;
# .env.example explains each one in more detail. Restart both services after a change.
#
# Values that differ from .env.example's defaults are marked "server:".
#
# WARNING: the server loads this whole file into its environment, and when Loop itself starts the
# tmux server, every agent inherits it, secrets included. Start tmux clean as docs/unattended.md
# ("The tmux session") shows, and check it there, until a code fix lands.

# ================================ Secrets ================================
# Two different random strings: `openssl rand -hex 32`. setup fills them in. No # in them.
DASHBOARD_TOKEN=
MCP_TOKEN=

# ================================ Folders ================================
# Absolute. setup sets ~/loop-worktrees. Session worktrees and, below it, the loop's job checkouts.
WORKTREES_ROOT=
# Scratch checkouts for PR jobs and the Production Guardian's evidence. Default $WORKTREES_ROOT/.loop-jobs
LOOP_JOBS_ROOT=
# The database. Back up its folder (docs/unattended.md#backups). Relative paths are from the repo root.
LOOP_DB_PATH=./data/loop.db
# The shared pipeline's stage files. Default data/stages.
STAGES_DIR=
# Where Claude keeps its login and conversations. Default ~/.claude. If you set it, add it to the
# clean tmux line in the server unit too, so builders use the same folder.
CLAUDE_CONFIG_DIR=
# The usage-limit snapshot scripts/capture-claude-usage.sh writes (README, "Usage meters").
# Default ~/.local/state/loop-engineering/claude-usage.json.
CLAUDE_USAGE_FILE=

# ======================== Server (apps/server) ========================
# Keep everything on loopback and reach it over SSH (docs/unattended.md#reaching-the-dashboard).
SERVER_URL=http://127.0.0.1:8787
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Leave empty: on, it lets SERVER_HOST be a non-loopback address.
ALLOW_NON_LOCAL_BIND=
# Leave off: on, /mcp also takes the raw MCP_TOKEN (manual testing; refused with NODE_ENV=production).
MCP_ALLOW_SHARED_TOKEN=off
# Browser origins allowed to call /api. Empty: the local dashboard only.
CORS_ORIGINS=

# ======================== Dashboard (apps/dashboard) ========================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3737
# server: password. On loopback the default is no login, which anyone with a shell on this machine
# could use. With password and the values below empty, nobody can sign in: on loopback the dashboard
# starts and its login page says what is missing; on any other host it refuses to start.
DASHBOARD_AUTH=password
# 12+ characters, shared with the team.
DASHBOARD_PASSWORD=
# 32+ random characters: `openssl rand -hex 32`. Changing it signs everyone out.
DASHBOARD_SESSION_SECRET=
# server: a fixed range, so the terminals under each pipeline can be forwarded over SSH with the dashboard.
WEB_TERMINAL_PORTS=3800-3829

# ======================== Sessions (packages/runner) ========================
# At Claude's usage limit: wait (default; resumed on Claude every 30 minutes) or opencode.
CLAUDE_LIMIT=
# Optional keys for the MCP servers every session gets. Each agent's launch script sets them.
TAVILY_API_KEY=
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Claude's login for PR-loop jobs. Leave these commented out when `claude` is logged in under this
# user's HOME (the usual case). Jobs receive them from the server's environment; builders need them
# on the clean tmux line in the server unit. With ANTHROPIC_API_KEY set, Claude bills the API instead
# of your subscription.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ======================== The PR loop (packages/loop) ========================
# server: on. Needs `gh auth login`. It merges and reverts for real; auto-merge is per project.
LOOP_ENGINE=on
# Agent jobs (tests, review, QA) at once across all PRs. Default 4.
LOOP_MAX_JOBS=4
# server: 45. Time for one job; waiting for a heavy slot doesn't count. Default 30.
LOOP_JOB_TIMEOUT_MINUTES=45
# server: 30. The limit for every job that drives a browser (QA among them), which needs more room on
# a loaded machine. Default 15, never more than LOOP_JOB_TIMEOUT_MINUTES.
LOOP_QA_TIMEOUT_MINUTES=30
# Review rounds before a PR goes to a person. Default 5.
LOOP_MAX_ROUNDS=
# Seconds between the loop's passes over open PRs. Default 30.
LOOP_TICK_SECONDS=
# Model for jobs on Claude. Default: the session model from the dashboard's settings.
LOOP_JOB_MODEL=
# The CLI for each kind of job: claude, opencode or builder. Defaults: review claude, tests opencode,
# QA claude, conflict claude, custom checks claude.
LOOP_REVIEW_PROVIDER=
LOOP_TESTS_PROVIDER=
LOOP_QA_PROVIDER=
LOOP_CONFLICT_PROVIDER=
LOOP_CHECK_PROVIDER=
# The Production Guardian's CLI: claude (default) or opencode. It runs for repos with a productionUrl.
LOOP_GUARDIAN_PROVIDER=

# ======================== Heavy runs (scripts/heavy) ========================
# server: 3 for 12 CPUs. Browser suites and full test runs at once on this machine, loop jobs and
# builders together. Lower it if the load average stays above the CPU count. Default 3.
LOOP_HEAVY_SLOTS=3
# Lock folder for the slots (a few empty files). Default /tmp/loop-heavy-<uid>.
LOOP_HEAVY_DIR=
# A builder's heavy run longer than this gets TERM, then KILL, and frees its slot. Default 7200. The
# loop's own jobs hold their slots for the job's timeout instead.
LOOP_HEAVY_MAX_SECONDS=
# Read by scripts/heavy only: seconds between TERM and KILL (default 30) and between checks for a free
# slot (default 5). Rarely worth changing.
# LOOP_HEAVY_GRACE_SECONDS=
# LOOP_HEAVY_POLL_SECONDS=

# ======================== Email (apps/server/src/modules/email) ========================
# Off while EMAIL_ADDRESS is empty. Set it on ONE machine only: every machine with it set would read
# the same inbox and answer every mail. A Google account only the loop uses, with an app password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Exact addresses where you can; @domain only for your own domain (public providers are refused).
EMAIL_ALLOWLIST=
# The project (its dashboard name) every mailed task goes to, and one sentence on what it is.
EMAIL_PROJECT=
EMAIL_PROJECT_ABOUT=
# Optional: the technical owner (on the allowlist). Gets decisions only the dashboard can take, and the
# agents' technical questions.
EMAIL_OWNER=
# Seconds between inbox reads, 15 to 3600. Default 60.
EMAIL_POLL_SECONDS=

# ======================== Not in .env ========================
# These belong to the services' environment (docs/unattended.md#services), not this file:
#   PATH     must reach node, git, tmux, gh, claude (and opencode, ttyd, jq if you use them)
#   LANG     C.UTF-8 or another UTF-8 locale
#   TMPDIR   a folder on disk when /tmp is RAM-backed (docs/unattended.md#temporary-files)
#   NODE_ENV production for the dashboard
