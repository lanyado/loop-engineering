{
  "name": "loop-engineering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orchestrator that runs coding agents in a loop. See SPEC.md.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanyado/loop-engineering.git"
  },
  "bin": {
    "loop": "scripts/loop.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run build && node apps/server/dist/setup.js",
    "start": "node scripts/start.mjs",
    "start:server": "node apps/server/dist/main.js",
    "add-project": "tsc -b tsconfig.build.json && node apps/server/dist/add-project.js",
    "loop": "tsc -b tsconfig.build.json && node apps/server/dist/loop-command.js",
    "build": "tsc -b tsconfig.build.json && npm run build -w @loop-engineering/dashboard",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run test:e2e -w @loop-engineering/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
