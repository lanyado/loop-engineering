# Copy to .env (gitignored) and fill in. `npm start` (apps/server) reads it from the repo root.

# --- Always-on server (apps/server) ---
# URL of the server. The dashboard calls the API there, and sessions reach the ask_human MCP tool at
# $SERVER_URL/mcp. Local-only setup: http://127.0.0.1:<SERVER_PORT>.
SERVER_URL=http://127.0.0.1:8787
# Interface to bind. Keep 127.0.0.1 (this machine only). Anything else is refused at start unless
# ALLOW_NON_LOCAL_BIND=on, and then logs a loud warning: other devices on the network can reach it.
SERVER_HOST=127.0.0.1
ALLOW_NON_LOCAL_BIND=
SERVER_PORT=8787
# SQLite file holding orchestrator state (pending questions survive restarts here).
LOOP_DB_PATH=./data/loop.db
# Bearer tokens: 16+ characters from A-Z a-z 0-9 . _ ~ + / - (optionally ending in =), e.g.
# `openssl rand -hex 32`. Other characters, # included, are rejected at start. Note that an unquoted #
# starts a comment in .env, so a token containing # is silently cut short there and then fails the
# length check instead; quote such a value ("...") to see the real error, or better, generate a new one.
# DASHBOARD_TOKEN guards /api/* (dashboard: questions, answers, SSE events). Required.
DASHBOARD_TOKEN=
# MCP_TOKEN guards /mcp (agents calling ask_human). Required, same characters as above, and different
# from DASHBOARD_TOKEN so an agent cannot answer its own questions.
MCP_TOKEN=
# /mcp only accepts each session's own token, HMAC-SHA256(MCP_TOKEN, "session:<id>"), which the runner
# gives the agent. on: also accept the raw MCP_TOKEN (manual testing only; logs a warning, refused with
# NODE_ENV=production). Default off.
MCP_ALLOW_SHARED_TOKEN=off
# Comma-separated browser origins allowed to call /api/*. Empty: only the local dashboard,
# http://127.0.0.1:<DASHBOARD_PORT> and http://localhost:<DASHBOARD_PORT>.
CORS_ORIGINS=

# --- Telegram bot (packages/telegram) --- see README "Telegram bot"
# Token from @BotFather. Empty: the bot is disabled and the server runs without it.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the owner (ask @userinfobot). Other users are allowed by adding their ids to core Settings.telegramAllowlist (e.g. PATCH /api/settings).
TELEGRAM_OWNER_ID=
# IANA time zone for question deadlines (e.g. Asia/Jerusalem). Empty: the server's zone.
TELEGRAM_TIME_ZONE=

# --- Sessions (packages/runner) ---
# Folder where per-session worktrees are created. When set, the server creates its one session runner
# (and usage-limit monitor), shared by the PR loop and the router.
WORKTREES_ROOT=
# What a Claude builder does at its usage limit: wait (default: stays paused and is resumed on Claude
# every 30 minutes) or opencode (relaunched on the free fallback model, which stalls on long work).
CLAUDE_LIMIT=
# The runner reads MCP_TOKEN (above) and passes it to each launched agent's environment; the MCP
# configs it writes only reference it as ${MCP_TOKEN}, and send X-Loop-Session-Id: <session id>.
# Optional keys for the MCP servers every session gets (passed through to the agent when set).
TAVILY_API_KEY=
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: where Claude keeps conversations (transcripts for the searchable history are read from
# $CLAUDE_CONFIG_DIR/projects). Default ~/.claude.
CLAUDE_CONFIG_DIR=

# Claude Code usage limits (5-hour and weekly) for the dashboard's top bar. Saved by
# scripts/capture-claude-usage.sh, which your status line script calls (see README). Default
# ~/.local/state/loop-engineering/claude-usage.json; set it in both places if you change it.
CLAUDE_USAGE_FILE=

# --- PR loop (packages/loop, run by apps/server) ---
# Off unless "on": once on, it reviews, tests, merges and reverts real PRs of the sessions it runs.
# It uses the gh CLI (your gh auth) and the claude / opencode CLIs; Vercel deploys are read from
# GitHub deployment statuses, so no Vercel token is needed. Needs WORKTREES_ROOT (above).
LOOP_ENGINE=
# Scratch checkouts for reviewer/tester jobs. Default: $WORKTREES_ROOT/.loop-jobs
LOOP_JOBS_ROOT=
# Agent jobs (reviewer, tester, QA) running at once across all PRs. Default 4.
LOOP_MAX_JOBS=
# A job running longer is killed and retried (escalated after 3 failed attempts). Default 30.
LOOP_JOB_TIMEOUT_MINUTES=
# Review rounds before a PR goes to the human. Default 5.
LOOP_MAX_ROUNDS=
# How often the loop checks PRs. Default 30.
LOOP_TICK_SECONDS=
# Model for jobs on Claude. Default: the session model from Settings (fallback model on OpenCode).
LOOP_JOB_MODEL=
# Which CLI runs each job: claude, opencode (free models) or builder (same as the PR's builder session).
# A Claude job still moves to OpenCode when Claude is out of usage; an approval from an OpenCode review
# then waits for the human instead of auto-merging. Defaults: review claude, tests opencode, QA claude.
LOOP_REVIEW_PROVIDER=
LOOP_TESTS_PROVIDER=
LOOP_QA_PROVIDER=
# The job that resolves a merge conflict before the builder is asked. Default claude.
LOOP_CONFLICT_PROVIDER=
# The Production Guardian's checks of the live site (repos with a productionUrl). Default claude.
LOOP_GUARDIAN_PROVIDER=

# --- Dashboard (apps/dashboard, Vercel) ---
# Set these in the dashboard's own environment (Vercel project env, or apps/dashboard/.env.local for
# `next dev`). All are server-side only: none is NEXT_PUBLIC_, so none reaches the browser.
# Interface and port `npm run dev|start -w @loop-engineering/dashboard` listens on (shell environment,
# not .env.local). Default 127.0.0.1:3737 = this machine only. Any other DASHBOARD_HOST (0.0.0.0, a LAN
# address) exposes the dashboard to the network and requires DASHBOARD_AUTH=password (below).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3737
# SERVER_URL (above) is where the dashboard's server calls the API with DASHBOARD_TOKEN (above).
# Leave SERVER_URL unset for demo mode: read-only fixture data, labelled "Demo data".
# none (no login) or password. Default: none while DASHBOARD_HOST is loopback (127.0.0.1, localhost,
# ::1); none mode answers only Host 127.0.0.1/localhost/[::1]:<port> and same-origin writes. Any other
# DASHBOARD_HOST, and Vercel, need DASHBOARD_AUTH=password plus the two variables below, or the
# dashboard refuses to start.
DASHBOARD_AUTH=
# password mode only: the password viewers log in with (12+ characters); they get a signed httpOnly
# cookie for 30 days.
DASHBOARD_PASSWORD=
# password mode only: key for signing that cookie, 32+ random characters (`openssl rand -hex 32`).
# Required in production, on Vercel and on a non-loopback host; optional for local `next dev`.
# Rotating it signs every viewer out, which is also how to revoke a cookie.
DASHBOARD_SESSION_SECRET=
